{%- doc -%}
  Renders the hero split icon text section.

  @param {string} children - The header content (heading, text, button)
  @param {string} list_items - The icon-text card items
  @param {object} settings - The section settings
  @param {number} slide_count - Number of card items

  @example
  {% render '1-client-hero-split-icon-text', children: children, list_items: list_items, settings: section.settings, slide_count: 3 %}
{%- enddoc -%}

{% liquid
  assign list_items_array = list_items | strip | split: '<!--@hero-split/split-->'
%}

<div class="section-background color-{{ settings.color_scheme }}"></div>
<div
  class="1-client-hero-split section section--{{ settings.section_width }} spacing-style color-{{ settings.color_scheme }}"
  style="
    --hero-split-gap: {{ settings.gap | default: 80 }}px;
    --hero-split-cards-width: {{ settings.cards_column_width | default: 421 }}px;
    --hero-split-cards-gap: {{ settings.cards_gap | default: 16 }}px;
    {% if settings.section_height == 'custom' %}
      --section-min-height: {{ settings.section_height_custom }}svh;
    {% elsif settings.section_height == 'full-screen' %}
      --section-min-height: 100svh;
    {% elsif settings.section_height != '' %}
      --section-min-height: var(--section-height-{{ settings.section_height }});
    {% endif %}

    {% if settings.section_height != '' %}
     --section-preview-height: 600px;
     {% endif %}
  "
>
  <div class="custom-section-background">
    {%- comment -%} Background image {%- endcomment -%}
    <div class="1-client-hero-split__bg background-image-container" aria-hidden="true">
      {%- if settings.custom_mobile_image and settings.image_mobile != blank -%}
        <picture>
          <source media="(max-width: 749px)" srcset="{{ settings.image_mobile | image_url: width: 800 }}">
          <source media="(min-width: 750px)" srcset="{{ settings.image | image_url: width: 1920 }}">
          <img
            src="{{ settings.image | image_url: width: 1920 }}"
            alt="{{ settings.image.alt | escape }}"
            loading="lazy"
            width="{{ settings.image.width }}"
            height="{{ settings.image.height }}"
          >
        </picture>
      {%- elsif settings.image != blank -%}
        <img
          src="{{ settings.image | image_url: width: 1920 }}"
          alt="{{ settings.image.alt | escape }}"
          loading="lazy"
          width="{{ settings.image.width }}"
          height="{{ settings.image.height }}"
        >
      {%- endif -%}
    </div>

    {%- comment -%} Gradient overlays {%- endcomment -%}
    {%- if settings.overlay_gradient_1 != blank -%}
      <div
        class="1-client-hero-split__overlay overlay"
        aria-hidden="true"
        style="background: {{ settings.overlay_gradient_1 }};"
      ></div>
    {%- endif -%}
    {%- if settings.overlay_gradient_2 != blank -%}
      <div
        class="1-client-hero-split__overlay overlay"
        aria-hidden="true"
        style="background: {{ settings.overlay_gradient_2 }};"
      ></div>
    {%- endif -%}
  </div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="custom-section-content">
    <div
      class="
        1-client-hero-split__content
        spacing-style
        layout-panel-flex
        layout-panel-flex--row
        section-content-wrapper
        mobile-column
      "
      style="
        {% render 'layout-panel-style', settings: settings %}
        {% render 'spacing-style', settings: settings %}
      "
    >
      {%- if children != blank -%}
        <div class="1-client-hero-split__header">
          {{ children }}
        </div>
      {%- endif -%}

      {%- comment -%} Desktop: vertical card stack {%- endcomment -%}
      {%- if list_items != blank -%}
        <div class="1-client-hero-split__cards hidden--mobile">
          {{ list_items }}
        </div>
      {%- endif -%}
      {%- comment -%} Mobile: carousel {%- endcomment -%}
      {%- if slide_count > 0 -%}
        <div class="1-client-hero-split__carousel hidden--desktop" style="--resource-list-column-gap: 8px">
          {% render '1-list-carousel',
            ref: 'heroSplitCarousel',
            slides: list_items_array,
            slide_count: slide_count,
            settings: settings
          %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .section-wrapper {
    --section-height-offset: 0px;
  }

  .section[data-shopify-visual-preview] {
    min-height: var(--section-preview-height);
    padding-top: 0;
  }

  .section[data-shopify-visual-preview] .custom-section-background {
    display: none;
  }

  body:has(> #header-group > .header-section > #header-component[transparent]):not(
      :has(> #header-group > .header-section + .shopify-section)
    )
    > main
    > .section-wrapper:first-child {
    --section-height-offset: var(--header-group-height, 0);
  }

  .custom-section-background {
    grid-column: 1 / -1;
  }

  .custom-section-content {
    z-index: var(--layer-flat);
  }
  /* HERO SPLIT ICON TEXT */
  .\31-client-hero-split {
    position: relative;
    overflow: hidden;
  }

  .\31-client-hero-split__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .\31-client-hero-split__cards {
    width: var(--hero-split-cards-width, 421px);
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--hero-split-cards-gap, 16px);
  }

  .\31-client-hero-split__card {
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    background: rgb(var(--color-foreground-rgb) / 0.2);
    border-radius: 8px;
    overflow: clip;
  }
  .\31-client-hero-split__carousel {
    width: 100%;
    slideshow-container {
      backdrop-filter: blur(5px);
    }
    .\31-resource-list__carousel {
      --gutter-slide-width: 0;
      --dot-width: 10px;
      --dot-height: 10px;
      --gap: 0;
      width: 100%;
      .slideshow-controls__dots {
        margin-block: 0;
      }
    }
    slideshow-slides {
      padding-inline: 0;
    }
    .resource-list__slide {
      --slide-width--mobile: 100%;
    }
  }

  /* Carousel dot styles live in assets/1-client.css */
{% endstylesheet %}
