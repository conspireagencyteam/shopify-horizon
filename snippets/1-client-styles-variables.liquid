<style>
  /* Custom Font Face Declarations */

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-Book.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-Medium.woff" | asset_url }}') format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-MediumItalic.woff" | asset_url }}') format('woff');
    font-weight: 500;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-Bold.woff" | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Custom Font families with theme fallbacks */
    --font-body--family: "Suisse Intl Trial", {{ settings.type_body_font.fallback_families }};
    --font-subheading--family: "Suisse Intl Trial", {{ settings.type_subheading_font.fallback_families }};
    --font-heading--family: "Suisse Intl Trial", {{ settings.type_heading_font.fallback_families }};
    --font-accent--family: "Suisse Intl Trial", {{ settings.type_accent_font.fallback_families }};

    --button-padding-inline: 36px;
    --button-padding-block: 13px;

    --minimum-touch-target: 36px;

    --spacing-scale-sm: 0.333333;


    /*
     * Primary Button Effect Override
     * Shows a decorative effect on primary/secondary buttons when the button
     * background is any non-transparent color. This ensures the effect
     * is visible on all color schemes with solid button backgrounds
     * but hidden when the background is transparent.
     */
    {% for scheme in settings.color_schemes -%}
      {% if scheme.settings.primary_button_background != 'rgba(0,0,0,0)' or scheme.settings.secondary_button_background != 'rgba(0,0,0,0)' %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        .color-{{ scheme.id }} {
          {% if scheme.settings.primary_button_background != 'rgba(0,0,0,0)' %}
            --effect-primary-button-display: block;
          {% endif %}
          {% if scheme.settings.secondary_button_background != 'rgba(0,0,0,0)' %}
            --effect-secondary-button-display: block;
          {% endif %}
        }
      {% endif %}
    {% endfor %}


    /* Typography presets

       Knowbody fluid scaling:
       - Sizes >= fluid_size_cutoff get a calc-based clamp that interpolates
         linearly from mobile_floor_px at mobile_viewport to the configured
         size at desktop_viewport.
       - Sizes < cutoff (or equal to/below the floor) emit static rem.
       With current settings only H1 (80) and H2 (48) cross the cutoff. */
    {% liquid
      assign font_sizes = "paragraph, h1, h2, h3, h4, h5, h6" | split: ", "
      assign fluid_size_cutoff = 48
      assign mobile_floor_px = 32
      assign mobile_viewport = 375
      assign desktop_viewport = 1400
      assign viewport_range = desktop_viewport | minus: mobile_viewport
      assign floor_rem = mobile_floor_px | divided_by: 16.0

      for font_size in font_sizes
        assign size_setting = 'type_size_[font_size]' | replace: '[font_size]', font_size
        assign font_size_value = settings[size_setting] | times: 1

        if font_size_value >= fluid_size_cutoff and font_size_value > mobile_floor_px
          assign max_rem = font_size_value | divided_by: 16.0
          assign delta_px = font_size_value | minus: mobile_floor_px

          echo '--font-size--[font_size]: clamp([floor_rem]rem, calc([floor_rem]rem + [delta_px] * (100vw - [mobile_viewport]px) / [viewport_range]), [max_rem]rem);' | replace: '[font_size]', font_size | replace: '[floor_rem]', floor_rem | replace: '[delta_px]', delta_px | replace: '[mobile_viewport]', mobile_viewport | replace: '[viewport_range]', viewport_range | replace: '[max_rem]', max_rem
        else
          assign static_rem = font_size_value | divided_by: 16.0
          echo '--font-size--[font_size]: [static_rem]rem;' | replace: '[font_size]', font_size | replace: '[static_rem]', static_rem
        endif
      endfor
    %}


  }
</style>
