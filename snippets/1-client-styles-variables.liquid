<style>
  /* Custom Font Face Declarations */

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-Book.woff" | asset_url }}') format('woff');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-Medium.woff" | asset_url }}') format('woff');
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-MediumItalic.woff" | asset_url }}') format('woff');
    font-weight: 500;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Suisse Intl Trial';
    src: url('{{ "1-SuisseIntlTrial-Bold.woff" | asset_url }}') format('woff');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    /* Custom Font families with theme fallbacks */
    --font-body--family: "Suisse Intl Trial", {{ settings.type_body_font.fallback_families }};
    --font-subheading--family: "Suisse Intl Trial", {{ settings.type_subheading_font.fallback_families }};
    --font-heading--family: "Suisse Intl Trial", {{ settings.type_heading_font.fallback_families }};
    --font-accent--family: "Suisse Intl Trial", {{ settings.type_accent_font.fallback_families }};

    --button-padding-inline: 36px;
    --button-padding-block: 13px;

    

    /*
     * Primary Button Effect Override
     * Shows a decorative effect on primary/secondary buttons when the button
     * background is any non-transparent color. This ensures the effect
     * is visible on all color schemes with solid button backgrounds
     * but hidden when the background is transparent.
     */
    {% for scheme in settings.color_schemes -%}
      {% if scheme.settings.primary_button_background != 'rgba(0,0,0,0)' or scheme.settings.secondary_button_background != 'rgba(0,0,0,0)' %}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        .color-{{ scheme.id }} {
          {% if scheme.settings.primary_button_background != 'rgba(0,0,0,0)' %}
            --effect-primary-button-display: block;
          {% endif %}
          {% if scheme.settings.secondary_button_background != 'rgba(0,0,0,0)' %}
            --effect-secondary-button-display: block;
          {% endif %}
        }
      {% endif %}
    {% endfor %}
  }
</style>
