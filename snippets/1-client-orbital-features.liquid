{%- doc -%}
  Renders the orbital features section — items arranged in an arc around a center image.
  Uses CSS grid with nth-child placement to split items into left/right columns.

  @param {string} header - The DOM content of the header (static _content block).
  @param {string} items - The DOM content of all feature items (rendered via content_for 'blocks').
  @param {object} settings - The section settings.
  @param {string} footer - The DOM content of the footer (static _content block).

  @example
  {% render '1-client-orbital-features', header: header, items: items, settings: section.settings, footer: footer %}
{%- enddoc -%}

{% liquid
  assign image = settings.image
  assign widths = '300, 400, 500, 600, 700, 800, 1000, 1200'
  assign sizes = '(max-width: 749px) min(350px, 90vw), clamp(300px, 50vw, 700px)'
%}

<div class="section-background color-{{ settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ settings.section_width }}
    color-{{ settings.color_scheme }}
  "
>
  <div
    class="
      1-client-orbital-features
      section-content-wrapper
      spacing-style
      1-spacing-style
    "
    style="{% render '1-spacing-style', settings: settings %}"
  >
    {% if header != blank %}
      <div class="1-client-orbital-features__header">
        {{ header }}
      </div>
    {% endif %}

    <div class="1-client-orbital-features__grid">
      <div class="1-client-orbital-features__items">
        {{ items }}
      </div>

      <div class="1-client-orbital-features__image">
        <div class="1-client-orbital-features__glow"></div>
        {% if image != blank %}
          {{
            image
            | image_url: width: 1200
            | image_tag:
              widths: widths,
              sizes: sizes,
              loading: 'lazy',
              class: '1-client-orbital-features__product-image'
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: '1-client-orbital-features__product-image' }}
        {% endif %}
      </div>
    </div>

    {% if footer != blank %}
      <div class="1-client-orbital-features__footer">
        {{ footer }}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .\31-client-orbital-features {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 2.5vw, 24px);
  }

  /* 3-column grid: left items | center image | right items */
  .\31-client-orbital-features__grid {
    display: grid;
    grid-template-columns: 1fr clamp(200px, 30vw, 400px) 1fr;
    grid-template-rows: repeat(3, auto);
    column-gap: clamp(16px, 2vw, 24px);
    row-gap: clamp(16px, 2vw, 24px);
    align-items: center;
  }

  /* Items wrapper uses display:contents so children become grid items */
  .\31-client-orbital-features__items {
    display: contents;
  }

  /* Left column: items 1-3 */
  .\31-client-orbital-features__items > :nth-child(1) {
    grid-column: 1;
    grid-row: 1;
  }
  .\31-client-orbital-features__items > :nth-child(2) {
    grid-column: 1;
    grid-row: 2;
  }
  .\31-client-orbital-features__items > :nth-child(3) {
    grid-column: 1;
    grid-row: 3;
  }

  /* Right column: items 4-6 */
  .\31-client-orbital-features__items > :nth-child(4) {
    grid-column: 3;
    grid-row: 1;
  }
  .\31-client-orbital-features__items > :nth-child(5) {
    grid-column: 3;
    grid-row: 2;
  }
  .\31-client-orbital-features__items > :nth-child(6) {
    grid-column: 3;
    grid-row: 3;
  }

  /* Center image spans all rows */
  .\31-client-orbital-features__image {
    grid-column: 2;
    grid-row: 1 / 4;
    position: relative;
    overflow: visible;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(300px, 35vw, 521px);
  }

  /* All items base styling */
  .\31-client-orbital-features__items > * {
    min-height: clamp(150px, 15vw, 200px);
    padding: clamp(16px, 2.5vw, 32px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Left column alignment */
  .\31-client-orbital-features__items > :nth-child(-n + 3) {
    justify-self: start;
  }

  /* Right column alignment */
  .\31-client-orbital-features__items > :nth-child(n + 4) {
    justify-self: end;
  }

  /* Arc: items 1,3 (left top/bottom) indent toward center */
  .\31-client-orbital-features__items > :nth-child(1),
  .\31-client-orbital-features__items > :nth-child(3) {
    padding-inline-start: clamp(32px, 7vw, 96px);
  }

  /* Arc: items 4,6 (right top/bottom) indent toward center */
  .\31-client-orbital-features__items > :nth-child(4),
  .\31-client-orbital-features__items > :nth-child(6) {
    padding-inline-end: clamp(32px, 7vw, 96px);
  }

  /* Glow behind image */
  .\31-client-orbital-features__glow {
    position: absolute;
    width: clamp(300px, 60vw, 874px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-secondary-button-background) 80%, transparent) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .\31-client-orbital-features__product-image {
    position: relative;
    width: clamp(300px, 50vw, 700px);
    height: auto;
    object-fit: cover;
  }

  /* Mobile: single column, items then image then items */
  @media (max-width: 749px) {
    .\31-client-orbital-features__grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: clamp(24px, 3vw, 32px);
    }

    /* Reset grid placement — items 1-3, then image, then items 4-6 */
    .\31-client-orbital-features__items > :nth-child(1) {
      grid-column: 1;
      grid-row: 1;
    }
    .\31-client-orbital-features__items > :nth-child(2) {
      grid-column: 1;
      grid-row: 2;
    }
    .\31-client-orbital-features__items > :nth-child(3) {
      grid-column: 1;
      grid-row: 3;
    }
    .\31-client-orbital-features__image {
      grid-column: 1;
      grid-row: 4;
    }
    .\31-client-orbital-features__items > :nth-child(4) {
      grid-column: 1;
      grid-row: 5;
    }
    .\31-client-orbital-features__items > :nth-child(5) {
      grid-column: 1;
      grid-row: 6;
    }
    .\31-client-orbital-features__items > :nth-child(6) {
      grid-column: 1;
      grid-row: 7;
    }

    /* Center all items on mobile */
    .\31-client-orbital-features__items > * {
      justify-self: center;
      padding-inline: 24px;
      min-height: auto;
    }

    /* Remove arc padding on mobile */
    .\31-client-orbital-features__items > :nth-child(1),
    .\31-client-orbital-features__items > :nth-child(3),
    .\31-client-orbital-features__items > :nth-child(4),
    .\31-client-orbital-features__items > :nth-child(6) {
      padding-inline-start: 24px;
      padding-inline-end: 24px;
    }

    .\31-client-orbital-features__image {
      min-height: clamp(180px, 30vw, 240px);
    }

    .\31-client-orbital-features__product-image {
      width: min(350px, 90vw);
    }

    .\31-client-orbital-features__glow {
      width: min(320px, 80vw);
    }
  }
{% endstylesheet %}
