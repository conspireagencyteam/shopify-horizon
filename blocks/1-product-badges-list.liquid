{%- liquid
  assign product = closest.product
  assign namespace = block.settings.metafield_namespace | default: 'product_details'
  assign key = block.settings.metafield_key | default: 'badges'
  assign badges = product.metafields[namespace][key].value
-%}

{%- if badges != blank and badges.size > 0 -%}
  <ul
    class="1-product-badges-list {{ block.settings.type_preset }}{% if block.settings.type_preset == 'custom' %} custom-typography{% endif %}"
    style="
      --badge-bg: {{ block.settings.pill_background }};
      --badge-color: {{ block.settings.pill_text_color }};
      --color: {{ block.settings.pill_text_color }};
      --badge-radius: {{ block.settings.pill_radius }}px;
      --badge-gap: {{ block.settings.gap }}px;
      --badge-icon-size: {{ block.settings.icon_size }}px;
      {% render '1-typography-style', settings: block.settings %}
      padding-block-start: {{ block.settings.padding-block-start }}px;
      padding-block-end: {{ block.settings.padding-block-end }}px;
      padding-inline-start: {{ block.settings.padding-inline-start }}px;
      padding-inline-end: {{ block.settings.padding-inline-end }}px;
    "
    {{ block.shopify_attributes }}
  >
    {%- for badge in badges -%}
      <li class="1-product-badges-list__item">
        {%- if badge.image != blank -%}
          {%- assign badge_image = badge.image.value | default: badge.image -%}
          <img
            class="1-product-badges-list__icon"
            src="{{ badge_image | image_url: width: 64 }}"
            alt="{{ badge.title.value | default: badge.title | escape }}"
            width="{{ block.settings.icon_size }}"
            height="{{ block.settings.icon_size }}"
            loading="lazy"
          >
        {%- endif -%}
        <span class="1-product-badges-list__label">
          {{- badge.title.value | default: badge.title -}}
        </span>
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
{% stylesheet %}
  /* Product badges list */
  .\31-product-badges-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--badge-gap);
    align-items: center;
  }

  .\31-product-badges-list__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background-color: var(--badge-bg);
    color: var(--color, var(--badge-color));
    border-radius: var(--badge-radius);
    line-height: 1.2;
    position: relative;
    box-shadow: inset 0 -1px 1px 0 rgb(0 0 0 / 25%), inset 0 1px 2px 0 rgb(255 255 255 / 100%);
  }

  .\31-product-badges-list:not(.custom-typography) .\31-product-badges-list__item {
    font-size: 13px;
  }

  .\31-product-badges-list__icon {
    width: var(--badge-icon-size);
    height: var(--badge-icon-size);
    flex-shrink: 0;
    object-fit: contain;
  }

  .\31-product-badges-list__label {
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }

  .\31-product-badges-list.custom-typography .\31-product-badges-list__label {
    font-family: var(--font-family);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    letter-spacing: var(--letter-spacing);
    text-transform: var(--text-transform);
    text-wrap: var(--text-wrap);
    line-height: var(--line-height);
  }
{% endstylesheet %}
