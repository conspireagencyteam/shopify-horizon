{%- liquid
  assign label = block.settings.override_text
  if label == blank
    assign label = closest.product.type
  endif
-%}

{%- if label != blank -%}
  <div
    class="1-product-type-pill {{ block.settings.type_preset }}{% if block.settings.type_preset == 'custom' %} custom-typography{% endif %}"
    style="
      --pill-bg: {{ block.settings.background_color }};
      --color: {{ block.settings.text_color }};
      --pill-radius: {{ block.settings.corner_radius }}px;
      {% render '1-typography-style', settings: block.settings %}
      padding-block-start: {{ block.settings.padding-block-start }}px;
      padding-block-end: {{ block.settings.padding-block-end }}px;
      padding-inline-start: {{ block.settings.padding-inline-start }}px;
      padding-inline-end: {{ block.settings.padding-inline-end }}px;
    "
    {{ block.shopify_attributes }}
  >
    <span class="1-product-type-pill__label">{{ label }}</span>
  </div>
{%- endif -%}
{% stylesheet %}
  .\31-product-type-pill {
    display: inline-flex;
    align-items: center;
    background-color: var(--pill-bg);
    color: var(--color, currentColor);
    border-radius: var(--pill-radius);
    position: relative;
    box-shadow: inset 0 -1px 1px 0 rgb(0 0 0 / 25%), inset 0 1px 2px 0 rgb(255 255 255 / 100%);
    width: fit-content;
    line-height: 1.2;
  }

  .\31-product-type-pill.custom-typography {
    font-family: var(--font-family);
    font-size: var(--font-size);
    font-weight: var(--font-weight);
    letter-spacing: var(--letter-spacing);
    text-transform: var(--text-transform);
    text-wrap: var(--text-wrap);
    line-height: var(--line-height);
  }

  .\31-product-type-pill__label {
    position: relative;
    z-index: 1;
  }
{% endstylesheet %}
