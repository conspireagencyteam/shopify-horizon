<div class="1-client-stat-card" {{ block.shopify_attributes }}>
  <div class="1-client-stat-card__value-row">
    <span class="1-client-stat-card__value">{{ block.settings.value }}</span>
    <hr class="1-client-stat-card__divider">
  </div>
  <p class="1-client-stat-card__description">{{ block.settings.description }}</p>
</div>

{% stylesheet %}
  .\31-client-stat-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    justify-content: center;
    padding: 24px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(7.5px);
    -webkit-backdrop-filter: blur(7.5px);
    overflow: clip;
  }

  .\31-client-stat-card__value-row {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .\31-client-stat-card__value {
    font-size: 3rem;
    line-height: 1;
    letter-spacing: -0.03em;
    color: white;
  }

  .\31-client-stat-card__divider {
    width: 100%;
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    margin: 0;
  }

  .\31-client-stat-card__description {
    font-size: 1rem;
    line-height: 1.5;
    color: white;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .\31-client-stat-card {
      padding: 12px;
      gap: 8px;
    }

    .\31-client-stat-card__value-row {
      gap: 12px;
    }

    .\31-client-stat-card__value {
      font-size: 2rem;
    }

    .\31-client-stat-card__description {
      font-size: 13px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Stat Card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "value",
      "label": "t:settings.text",
      "default": "95%"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:settings.description",
      "default": "reduction in exercise-induced gut permeability"
    }
  ]
}
{% endschema %}
