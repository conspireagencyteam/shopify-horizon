{% liquid
  assign author = closest.article.metafields.blog_post_details.author.value
  assign reading_time = closest.article.metafields.blog_post_details.reading_time.value
%}

{% if author != blank %}
  <div class="1-client-written-by" {{ block.shopify_attributes }}>
    <div class="1-client-written-by__header">
      <h3 class="1-client-written-by__heading h4">Written by</h3>
      {%- content_for 'block', type: '_1-divider', id: 'divider-product' -%}
    </div>

    <div class="1-client-written-by__author">
      {% if author.image != blank %}
        <div class="1-client-written-by__avatar">
          {{
            author.image
            | image_url: width: 96
            | image_tag:
              width: 48,
              height: 48,
              class: '1-client-written-by__avatar-img',
              loading: 'lazy',
              alt: author.full_name
          }}
        </div>
      {% endif %}
      <div class="1-client-written-by__info">
        <span class="1-client-written-by__name">{{ author.full_name }}</span>
        {% if reading_time != blank %}
          <span class="1-client-written-by__read-time">{{ reading_time }} read</span>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .\31-client-written-by {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .\31-client-written-by__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .\31-client-written-by__heading {
    margin: 0;
  }

  .\31-client-written-by__author {
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: center;
  }

  .\31-client-written-by__avatar {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    overflow: hidden;
  }

  .\31-client-written-by__avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  .\31-client-written-by__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
    line-height: 1.2;
  }

  .\31-client-written-by__name {
    font-size: 1rem;
    letter-spacing: -0.48px;
    color: var(--color-foreground-heading);
  }

  .\31-client-written-by__read-time {
    font-size: 0.8125rem;
    letter-spacing: -0.39px;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Client Written By",
  "tag": null,
  "settings": [],
  "presets": []
}
{% endschema %}
