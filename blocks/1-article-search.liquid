{%- liquid
  assign default_placeholder = 'blogs.1_search_placeholder' | t
  assign placeholder = block.settings.placeholder_text | default: default_placeholder
  assign search_width = block.settings.search_width
-%}

<div
  class="1-article-search spacing-style {% if block.settings.inherit_color_scheme == false %}color-{{ block.settings.color_scheme }}{% endif %}"
  style="{% render '1-spacing-style', settings: block.settings %} --search-width: {{ search_width }};"
  {{ block.shopify_attributes }}
>
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="1-article-search__form"
  >
    <input type="hidden" name="type" value="article">
    <input
      type="search"
      name="q"
      placeholder="{{ placeholder }}"
      class="1-article-search__input"
      aria-label="{{ placeholder }}"
      autocomplete="off"
    >
    <button type="submit" class="1-article-search__button" aria-label="{{ 'accessibility.1_search' | t }}">
      {{ '1-icon-search.svg' | inline_asset_content }}
    </button>
  </form>
</div>

{% stylesheet %}
  .\31-article-search {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .\31-article-search__form {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    width: var(--search-width, 400px);
    max-width: 100%;
    padding-inline-start: 16px;
    padding-inline-end: 18px;
    padding-block: 16px;
    border-radius: 8px;
    background: var(--color-background);
    box-shadow: inset 0 -2px 2px 0 rgb(0 0 0 / 0.25), inset 0 2px 2px 0 rgb(255 255 255 / 0.5);
  }

  .\31-article-search__input {
    flex: 1;
    border: none;
    background: transparent;
    font-size: var(--font-size--md);
    line-height: 1.2;
    color: var(--color-foreground);
    outline: none;
    min-width: 0;
    padding: 0;
    font-family: inherit;
  }

  .\31-article-search__input::placeholder {
    color: var(--color-foreground);
    opacity: 0.5;
  }

  .\31-article-search__button {
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--color-foreground);
    flex-shrink: 0;
  }

  .\31-article-search__button svg {
    width: 20px;
    height: 20px;
  }

  @media screen and (max-width: 749px) {
    .\31-article-search__form {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.1_article_search",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "t:settings.1_placeholder_text",
      "default": "Search"
    },
    {
      "type": "select",
      "id": "search_width",
      "label": "t:settings.1_search_width",
      "options": [
        {
          "value": "300px",
          "label": "t:options.narrow"
        },
        {
          "value": "400px",
          "label": "t:options.normal"
        },
        {
          "value": "100%",
          "label": "t:options.fill"
        }
      ],
      "default": "400px"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.1_article_search",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
