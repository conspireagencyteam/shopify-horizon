{% if section.blocks.size > 1 %}
  {% capture controls %}
    {%- render 'slideshow-controls',
      style: section.settings.slideshow_controls_style,
      autoplay: section.settings.autoplay,
      item_count: section.blocks.size,
      show_arrows: false,
      arrows_on_media: true,
      controls_on_media: true,
      pagination_position: 'center',
      icon_style: section.settings.icons_style
    -%}
  {% endcapture %}
{% endif %}

{% capture slides %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign slideshow_class = 'slideshow--single-media'
  if section.blocks.size > 1
    assign slideshow_class = ''
  endif

  assign show_arrows = true
  if section.settings.icons_style == 'none' or section.blocks.size <= 1
    assign show_arrows = false
  endif

%}

{% if section.settings.slide_height == 'custom' %}
  {% style %}
    #shopify-section-{{ section.id }} slideshow-slides[size='custom'] {
      min-height: {{ section.settings.slide_height_custom }}svh;
    }
  {% endstyle %}
{% endif %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} disable-section-top-offset"
  style="{% render 'spacing-padding', settings: section.settings %}"
  {% if section.settings.allow_transparent_header %}allow-transparent-header{% endif %}
>
  {% render 'slideshow',
    class: slideshow_class,
    controls: controls,
    show_arrows: show_arrows,
    icon_style: section.settings.icons_style,
    autoplay: section.settings.autoplay,
    autoplay_speed: section.settings.autoplay_speed,
    slides: slides,
    slide_count: section.blocks.size,
    slide_size: section.settings.slide_height
  %}
</div>

{%if section.settings.allow_transparent_header %}
  <style>
    .\31-header {
      --transparent-color-background: rgb({{ section.settings.color_scheme_transparent.settings.background.rgba }});
      /* RGB values only to apply different opacities - Relative color values are not supported in iOS < 16.4 */
      --transparent-color-background-rgb: {{ section.settings.color_scheme_transparent.settings.background.rgb }};
      --transparent-color-foreground: rgb({{ section.settings.color_scheme_transparent.settings.foreground.rgba }});
      --transparent-color-foreground-rgb: {{ section.settings.color_scheme_transparent.settings.foreground.rgb }};
      --transparent-color-foreground-heading: rgb({{ section.settings.color_scheme_transparent.settings.foreground_heading.rgba }});
      --transparent-color-foreground-heading-rgb: {{ section.settings.color_scheme_transparent.settings.foreground_heading.rgb }};
      --transparent-color-primary: rgb({{ section.settings.color_scheme_transparent.settings.primary.rgba }});
      --transparent-color-primary-rgb: {{ section.settings.color_scheme_transparent.settings.primary.rgb }};
      --transparent-color-primary-hover: rgb({{ section.settings.color_scheme_transparent.settings.primary_hover.rgba }});
      --transparent-color-primary-hover-rgb: {{ section.settings.color_scheme_transparent.settings.primary_hover.rgb }};
      --transparent-color-border: rgb({{ section.settings.color_scheme_transparent.settings.border.rgba }});
      --transparent-color-border-rgb: {{ section.settings.color_scheme_transparent.settings.border.rgb }};
      --transparent-color-shadow: rgb({{ section.settings.color_scheme_transparent.settings.shadow.rgba }});
      --transparent-color-shadow-rgb: {{ section.settings.color_scheme_transparent.settings.shadow.rgb }};
      --transparent-color-primary-button-text: rgb({{ section.settings.color_scheme_transparent.settings.primary_button_text.rgba }});
      --transparent-color-primary-button-background: rgb({{ section.settings.color_scheme_transparent.settings.primary_button_background.rgba }});
      --transparent-color-primary-button-border: rgb({{ section.settings.color_scheme_transparent.settings.primary_button_border.rgba }});
      --transparent-color-primary-button-hover-text: rgb({{ section.settings.color_scheme_transparent.settings.primary_button_hover_text.rgba }});
      --transparent-color-primary-button-hover-background: rgb({{ section.settings.color_scheme_transparent.settings.primary_button_hover_background.rgba }});
      --transparent-color-primary-button-hover-border: rgb({{ section.settings.color_scheme_transparent.settings.primary_button_hover_border.rgba }});
      --transparent-color-secondary-button-text: rgb({{ section.settings.color_scheme_transparent.settings.secondary_button_text.rgba }});
      --transparent-color-secondary-button-background: rgb({{ section.settings.color_scheme_transparent.settings.secondary_button_background.rgba }});
      --transparent-color-secondary-button-border: rgb({{ section.settings.color_scheme_transparent.settings.secondary_button_border.rgba }});
      --transparent-color-secondary-button-hover-text: rgb({{ section.settings.color_scheme_transparent.settings.secondary_button_hover_text.rgba }});
      --transparent-color-secondary-button-hover-background: rgb({{ section.settings.color_scheme_transparent.settings.secondary_button_hover_background.rgba }});
      --transparent-color-secondary-button-hover-border: rgb({{ section.settings.color_scheme_transparent.settings.secondary_button_hover_border.rgba }});
    }
  </style>
{% endif %}
{% stylesheet %}
  slideshow-slides[size='full-screen'] {
    min-height: 100svh;
  }
{% endstylesheet %}

