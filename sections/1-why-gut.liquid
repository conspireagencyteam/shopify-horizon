{%- render '1-why-gut-scripts' -%}
{% capture children %}
  <div class="1-why-gut">
    <div class="1-why-gut__desktop">
      {%- render '1-why-gut-halo' -%}
    </div>
    <div class="1-why-gut__mobile">
      {%- render '1-why-gut-halo-mobile' -%}
    </div>
    {%- comment -%} z-index 3: hero text {%- endcomment -%}
    <div class="1-why-gut__content">
      {%- content_for 'blocks' -%}
    </div>
  </div>
{% endcapture %}

{% render '1-section', section: section, children: children %}
{% stylesheet %}
  .\31-why-gut {
    position: relative;
    width: 100%;
    aspect-ratio: 1314 / 900;
    overflow: hidden;
  }

  .\31-why-gut__svg-halo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .\31-why-gut__svg-base {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .\31-why-gut__content {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(0, -50%);
    width: 100%;
    z-index: 3;
  }

  .\31-why-gut__desktop,
  .\31-why-gut__mobile {
    position: absolute;
    inset: 0;
  }

  .\31-why-gut__mobile {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .\31-why-gut {
      aspect-ratio: 375 / 800;
    }

    .\31-why-gut__desktop {
      display: none;
    }

    .\31-why-gut__mobile {
      display: block;
    }
  }

  /* halos hidden until JS positions them on the path */
  #haloA,
  #haloB,
  #haloAMobile,
  #haloBMobile {
    visibility: hidden;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.1_section",
  "class": "section-wrapper",
  "blocks": [{ "type": "1-text" }, { "type": "1-button" }, { "type": "1-group" }],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
