{%- render '1-client-why-gut-scripts' -%}
<one-client-why-gut class="1-client-why-gut color-{{ section.settings.color_scheme }}">
  <div class="1-client-why-gut__halo-layer 1-client-why-gut__halo-layer--desktop" data-ref="layout-desktop">
    {%- render '1-client-why-gut-halo', uid: section.id -%}
  </div>
  <div class="1-client-why-gut__halo-layer 1-client-why-gut__halo-layer--mobile" data-ref="layout-mobile">
    {%- render '1-client-why-gut-halo-mobile', uid: section.id -%}
  </div>

  {% capture children %}
    <div class="1-client-why-gut__content">
      {%- content_for 'blocks' -%}
    </div>
  {% endcapture %}
  {% render '1-section', section: section, children: children %}
</one-client-why-gut>
{% stylesheet %}
  .\31-client-why-gut {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: min(calc(100vw * 900 / 1314), 900px);
  }

  .\31-client-why-gut > .section {
    width: 100%;
  }

  .\31-client-why-gut__halo-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .\31-client-why-gut__halo-layer--desktop {
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: var(--page-width);
  }

  .\31-client-why-gut__halo-layer--mobile {
    display: none;
  }

  .\31-client-why-gut__svg-halo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .\31-client-why-gut__svg-base {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .\31-client-why-gut__content {
    position: relative;
    width: 100%;
    z-index: 2;
  }

  @media screen and (max-width: 749px) {
    .\31-client-why-gut {
      min-height: min(calc(100vw * 800 / 375), 800px);
    }

    .\31-client-why-gut__halo-layer--desktop {
      display: none;
    }

    .\31-client-why-gut__halo-layer--mobile {
      display: block;
    }
  }

  /* halos hidden until JS positions them on the path */
  .\31-client-why-gut__halo-spark {
    visibility: hidden;
  }
{% endstylesheet %}
