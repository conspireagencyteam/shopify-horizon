{% liquid
  assign search_types = search.types | join: ','
  assign show_articles = false
  if search_types contains 'article' or search.types.size == 0
    assign show_articles = true
  endif
%}

{% if show_articles %}
  {% paginate search.results by 24 %}
    {% assign articles = search.results | where: 'object_type', 'article' %}

    {% if articles.size > 0 %}
      <div class="section-background color-{{ section.settings.color_scheme }}"></div>
      <div
        class="section section--page-width spacing-style color-{{ section.settings.color_scheme }}"
        style="
          --padding-block-start: {{ section.settings.padding-block-start }}px;
          --padding-block-end: {{ section.settings.padding-block-end }}px;
        "
      >
        {% if section.settings.heading != blank %}
          <h3 class="1-search-article-results__heading">
            {{ section.settings.heading }}
          </h3>
        {% endif %}

        {% liquid
          capture styles
            echo '--resource-list-column-gap: ' | append: section.settings.columns_gap | append: 'px;'
            echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
            echo '--resource-list-row-gap: ' | append: section.settings.rows_gap | append: 'px;'
            echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
            echo '--resource-list-columns-per-row: ' | append: section.settings.columns | append: ';'
            echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
            echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
          endcapture
        %}

        <div
          class="1-search-article-results__grid resource-list--grid"
          style="{{ styles }}"
        >
          {%- for article in articles -%}
            <div class="1-search-article-results__item">
              {% content_for 'block', id: 'blog-post-card', type: '1-blog-post-card', closest.article: article %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {% elsif search.performed and search.terms != blank %}
      <div class="section-background color-{{ section.settings.color_scheme }}"></div>
      <div
        class="section section--page-width spacing-style color-{{ section.settings.color_scheme }}"
        style="
          --padding-block-start: {{ section.settings.padding-block-start }}px;
          --padding-block-end: {{ section.settings.padding-block-end }}px;
        "
      >
        {% if section.settings.heading != blank %}
          <h3 class="1-search-article-results__heading">
            {{ section.settings.heading }}
          </h3>
        {% endif %}
        <div class="1-search-article-results__empty">
          <p>{{ 'content.search_results_no_results_check_spelling' | t: terms: search.terms }}</p>
        </div>
      </div>
    {% endif %}
  {% endpaginate %}
{% endif %}

{% stylesheet %}
  .\31-search-article-results__heading {
    margin-block-end: var(--margin-xl);
  }

  .\31-search-article-results__empty {
    opacity: var(--opacity-subdued-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.1_search_article_results",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Articles"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "t:settings.mobile_columns",
      "options": [
        {
          "value": "1",
          "label": "t:options.one_number"
        },
        {
          "value": "2",
          "label": "t:options.two_number"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": []
}
{% endschema %}
