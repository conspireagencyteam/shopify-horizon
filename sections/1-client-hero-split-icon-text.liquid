{% capture children %}
  {%- content_for 'block', type: '_content', id: 'static-header' -%}
{% endcapture %}

{% capture list_items %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render '1-client-hero-split-icon-text',
  children: children,
  list_items: list_items,
  settings: section.settings,
  slide_count: section.blocks.size
%}

