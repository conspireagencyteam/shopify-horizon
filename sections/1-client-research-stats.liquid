{%- liquid
  assign bg_image = section.settings.background_image
-%}

{% capture children %}
  <div class="1-client-research-stats">
    {%- if bg_image != blank -%}
      <div class="1-client-research-stats__bg">
        <img
          src="{{ bg_image | image_url: width: 1920 }}"
          
          alt="{{ bg_image.alt | escape }}"
          loading="lazy"
          class="1-client-research-stats__bg-image"
        >
        <div class="1-client-research-stats__bg-overlay"></div>
      </div>
    {%- endif -%}

    <div class="1-client-research-stats__content">
      <div class="1-client-research-stats__stats-grid">
        {%- content_for 'blocks' -%}
      </div>

      <div class="1-client-research-stats__bottom">
        <div class="1-client-research-stats__text">
          <h2 class="1-client-research-stats__heading">{{ section.settings.heading }}</h2>
          <p class="1-client-research-stats__subheading">{{ section.settings.subheading }}</p>
        </div>
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url }}" class="1-client-research-stats__cta button">
            {{ section.settings.cta_text }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{% endcapture %}

{% render '1-section', section: section, children: children %}

{% stylesheet %}
  .\31-client-research-stats {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .\31-client-research-stats__bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .\31-client-research-stats__bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .\31-client-research-stats__bg-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
  }

  .\31-client-research-stats__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100svh;
    padding: 64px;
  }

  .\31-client-research-stats__stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 533px;
    margin-left: auto;
  }

  .\31-client-research-stats__bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    width: 100%;
  }

  .\31-client-research-stats__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
  }

  .\31-client-research-stats__heading {
    font-size: 5rem;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: white;
    margin: 0;
  }

  .\31-client-research-stats__subheading {
    font-size: 1rem;
    line-height: 1.5;
    color: white;
    margin: 0;
    max-width: 600px;
  }

  .\31-client-research-stats__cta {
    flex-shrink: 0;
  }

  @media screen and (max-width: 749px) {
    .\31-client-research-stats__content {
      padding: 32px 16px;
      justify-content: flex-end;
      gap: 16px;
    }

    .\31-client-research-stats__stats-grid {
      max-width: 100%;
      margin-left: 0;
    }

    .\31-client-research-stats__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .\31-client-research-stats__heading {
      font-size: 2.5rem;
    }

    .\31-client-research-stats__cta {
      width: 100%;
      text-align: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "1 Research Stats",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_1-client-stat-card" }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Backed by Research"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:settings.subheading",
      "default": "Easy daily routine for optimal absorption and results"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "t:settings.button_label",
      "default": "See Research"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "t:settings.video_external_url"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "full-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        { "value": "", "label": "t:options.auto" },
        { "value": "full-screen", "label": "t:options.full_screen" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        { "value": "none", "label": "t:options.none" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        { "value": "none", "label": "t:options.none" }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "padding_scale",
      "label": "t:settings.1_padding_scale",
      "options": [
        { "value": "1", "label": "1x" },
        { "value": "2", "label": "2x" },
        { "value": "3", "label": "3x" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "1 Research Stats",
      "category": "t:categories.storytelling",
      "blocks": {
        "stat_1": {
          "type": "_1-client-stat-card",
          "settings": { "value": "95%", "description": "reduction in exercise-induced gut permeability + citation" }
        },
        "stat_2": {
          "type": "_1-client-stat-card",
          "settings": { "value": "120", "description": "reduction in exercise-induced gut permeability + citation" }
        },
        "stat_3": {
          "type": "_1-client-stat-card",
          "settings": { "value": "87%", "description": "reduction in exercise-induced gut permeability + citation" }
        },
        "stat_4": {
          "type": "_1-client-stat-card",
          "settings": { "value": "80%", "description": "reduction in exercise-induced gut permeability + citation" }
        }
      },
      "block_order": ["stat_1", "stat_2", "stat_3", "stat_4"],
      "settings": {
        "section_width": "full-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
  ]
}
{% endschema %}
